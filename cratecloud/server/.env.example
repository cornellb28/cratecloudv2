# Stripe secret key (server-side only — never expose this in the Electron app)
STRIPE_SECRET_KEY=sk_test_...

# Signing secret for the /api/webhook endpoint (Stripe Dashboard > Webhooks,
# or `stripe listen --print-secret` while developing locally)
STRIPE_WEBHOOK_SECRET=whsec_...

# RSA private key (PEM, RS256) used to sign license tokens returned by
# /api/verify-session. The Electron app only ever sees the matching public
# key. When pasting a multi-line PEM into a single-line env var (e.g. the
# Vercel dashboard), replace real newlines with literal \n.
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional — overrides the host used to build Checkout success/cancel URLs.
# Defaults to the deployment's own request host if unset.
PUBLIC_BASE_URL=https://your-deployment.vercel.app
